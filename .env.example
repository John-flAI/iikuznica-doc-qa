# Настройки стенда. Скопировать в .env и заполнить. Ключи — только здесь или в окружении,
# в репозиторий не попадают (.env закрыт в .gitignore).

# --- Языковая модель: любой OpenAI-совместимый сервер ---
# На стенде — каталог из трёх открытых моделей и переключатель в шапке чата. Записи через «;»:
#   id|подпись на стенде|адрес сервера|имя модели|имя переменной окружения с ключом.
# Первая запись — по умолчанию. Запись без ключа в окружении на стенд не попадает.
# Тот же каталог задан в app/config.py (MODELS); переменная ниже нужна, чтобы заменить его своим.
# LLM_API_KEY — ключ Z.ai (запись zai-flash); COMETAPI_KEY — ключ CometAPI (записи comet-qwen и comet-oss)
LLM_API_KEY=
COMETAPI_KEY=
# LLM_MODELS=zai-flash|GLM-5.3-Flash · Z.ai|https://api.z.ai/api/coding/paas/v4|GLM-5.3-Flash|LLM_API_KEY;comet-qwen|Qwen3.5-122B-A10B · CometAPI|https://api.cometapi.com/v1|qwen3.5-122b-a10b|COMETAPI_KEY;comet-oss|gpt-oss-120b · CometAPI|https://api.cometapi.com/v1|gpt-oss-120b|COMETAPI_KEY

# Запасной клиент — только когда каталог пуст: основная модель и запасная на случай перегрузки.
# Имя в ответе API может отличаться от запрошенного — /api/health показывает model_served.
LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
LLM_MODEL=GLM-5.3-Flash
LLM_FALLBACK_MODEL=
# Локальный режим — та же открытая модель на своём сервере (Ollama, vLLM):
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=glm-4.7-flash:latest
# LLM_FALLBACK_MODEL=
# LLM_API_KEY=

# Где хранить состояние (база диалогов, индекс, ответы службы качества). По умолчанию — рядом с корпусом.
# REGQA_STATE=/var/lib/iikuznica

# --- Демонстрационный стенд: сколько вопросов в час можно задать с одного адреса (0 — без лимита) ---
# Каждый вопрос — вызов платной модели; лимит написан на странице стенда, адрес берётся из X-Forwarded-For прокси.
ASK_LIMIT=20

# --- Почта стенда: тестовый SMTP-сервер «host:port» (в docker на стенде — mailpit:1025) ---
# Пусто — письма только сохраняются в базе и доступны через /api/letters, по SMTP не уходят.
# MAIL_SMTP=

# --- Эмбеддинги: BGE-M3 (MIT), локальный сервер ---
EMBED_BASE_URL=http://127.0.0.1:11434/v1
EMBED_MODEL=bge-m3
EMBED_API_KEY=

# --- Только для запуска за reverse proxy (docker compose -f compose.yml -f compose.proxy.yml) ---
# Имя уже существующей docker-сети, в которой работает прокси. Без прокси не заполнять.
# PROXY_NETWORK=caddy
